{
	"name": "obsidian-youtube-whisper-transcription",
	"version": "1.0.0",
	"description": "Transcribe YouTube videos using OpenAI Whisper API or download existing captions",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"update-vendor-deps": "node scripts/update-vendor-deps.js",
		"update-vendor-deps:check": "node scripts/update-vendor-deps.js --check-only",
		"update-vendor-deps:youtubei": "node scripts/update-vendor-deps.js youtubei.js"
	},
	"keywords": ["obsidian", "plugin", "youtube", "transcription", "whisper", "openai"],
	"author": "mjasion",
	"license": "MIT",
	"dependencies": {
		"openai": "^4.0.0",
		"youtubei.js": "16.0.1"
	},
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	}
}
